{
  "expo": {
    "name": "Zenza",
    "slug": "Zenza",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "zenza",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kanelijo.zenza",
      "infoPlist": {
        "NSCameraUsageDescription": "Zenza needs camera access to scan student QR codes for attendance.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.kanelijo.zenza",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Zenza needs camera access to scan student QR codes."
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#AF2800"
        }
      ],
      "react-native-video",
      "expo-mail-composer"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1b1d0b2-c04d-4e47-bbde-ec7873709e4b"
      }
    },
    "owner": "nilesh_kuntal",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/e1b1d0b2-c04d-4e47-bbde-ec7873709e4b"
    }
  }
}
